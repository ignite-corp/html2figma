{
  "name": "@html2figma/account-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "html2figma 계정/구독 API (Figma OAuth + Paddle 웹훅, Cloudflare Workers + SQLite DO)",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "esbuild test/unit.ts --bundle --platform=node --format=esm --outfile=dist-test/unit.mjs && node dist-test/unit.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "clean": "rm -rf dist dist-test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
