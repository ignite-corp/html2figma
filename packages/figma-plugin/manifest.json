{
  "name": "html2figma",
  "id": "html2figma-importer",
  "api": "1.0.0",
  "main": "dist/main.js",
  "ui": "dist/ui.html",
  "editorType": ["figma"],
  "networkAccess": {
    "allowedDomains": [
      "ws://localhost:8787",
      "wss://html2figma-relay.workers.dev",
      "wss://*.workers.dev"
    ],
    "reasoning": "direct-send 릴레이(로컬 또는 공개 Cloudflare Workers)로부터 캡처 결과를 페어링 코드로 수신"
  }
}
